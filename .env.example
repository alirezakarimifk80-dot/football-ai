# ------------------------------------------------------------------
# Football AI — Environment Variables Template
# NEVER commit real keys or .env files to GitHub!
# On Cloudflare Pages: add GEMINI_API_KEY under Settings > Variables & Secrets.
# ------------------------------------------------------------------

# GEMINI_API_KEY: Required for AI Football Lab (Server-Side / Cloudflare Pages Function)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model override for Cloudflare Pages (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Public URL of your deployed site (optional)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Optional Upgrade: API-Football v3 (Server-Side Only)
# Live world football (7 leagues) + Iran Persian Gulf Pro League work
# automatically without needing an API-Football key.
# ------------------------------------------------------------------
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_DAILY_LIMIT="100"
API_FOOTBALL_PER_MINUTE_LIMIT="10"
API_FOOTBALL_QUOTA_BUFFER="5"
API_FOOTBALL_TIMEOUT_MS="10000"
API_FOOTBALL_MAX_RETRIES="2"
LIVE_POLL_INTERVAL_SECONDS="60"
CACHE_TTL_LIVE_SEC="45"
CACHE_TTL_FIXTURES_SEC="300"
CACHE_TTL_EVENTS_SEC="45"
CACHE_TTL_STATS_SEC="60"
CACHE_TTL_LINEUPS_SEC="600"
CACHE_TTL_STANDINGS_SEC="1800"
CACHE_TTL_LEAGUES_SEC="86400"
CACHE_TTL_TEAMS_SEC="21600"
CACHE_TTL_PLAYERS_SEC="21600"
CACHE_TTL_H2H_SEC="43200"
REDIS_URL=""

# ------------------------------------------------------------------
# Admin Passcode & Direct GitHub Upload (Server-Side Only)
# Set GITHUB_TOKEN in Settings > Secrets (Fine-grained PAT with
# Contents: Read & Write, or Classic PAT with repo scope).
# ------------------------------------------------------------------
ADMIN_PASSCODE=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=football-ai
GITHUB_BRANCH=main
